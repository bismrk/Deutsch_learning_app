# Основні налаштування бекенду
# Допустимі значення APP_ENV: development, staging, production, test
APP_ENV=development
# Допустимі значення LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deutsch_learning

# Telegram Bot та внутрішня авторизація між ботом і бекендом
BOT_TOKEN=your_telegram_bot_token_here
INTERNAL_API_KEY=change_me_internal_api_key

# OpenAI-сумісний LLM API (DeepSeek для MVP)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat
DAILY_LLM_LIMIT=50
