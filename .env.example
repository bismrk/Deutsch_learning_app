# Основні налаштування бекенду
# Допустимі значення APP_ENV: development, staging, production, test
APP_ENV=development
# Допустимі значення LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose та asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=deutsch_learning
# Для запуску в Docker Compose використовуйте хост postgres; для локального uvicorn поза Docker — 127.0.0.1
DATABASE_URL=postgresql+asyncpg://postgres:change_me_postgres_password@postgres:5432/deutsch_learning
# Окрема тестова база PostgreSQL для інтеграційних тестів і міграцій (ніколи не використовуйте основну БД)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change_me_postgres_password@127.0.0.1:5432/deutsch_learning_test

# Caddy Reverse Proxy (:80 для локальної розробки, example.com для продакшену з авто-HTTPS)
CADDY_SITE_ADDRESS=:80

# Telegram Bot та внутрішня авторизація між ботом і бекендом
BOT_TOKEN=your_telegram_bot_token_here
INTERNAL_API_KEY=change_me_internal_api_key
# URL бекенд API для бота (у Docker Compose: http://backend:8000; локально поза Docker: http://127.0.0.1:8000)
BACKEND_API_URL=http://backend:8000
# Публічний HTTPS URL Telegram Mini App (залиште порожнім локально без HTTPS-тунелю)
MINIAPP_URL=

# OpenAI-сумісний LLM API (DeepSeek для MVP)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat
DAILY_LLM_LIMIT=50
